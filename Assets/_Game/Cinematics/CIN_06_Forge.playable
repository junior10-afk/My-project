  m_Name: SubtitleClip
  m_EditorClassIdentifier: Assembly-CSharp::LastWorld.SubtitleClip
  speaker: Kael
  text: "Ce monde me doit cinq si\xE8cles. Qu'il se d\xE9brouille avec celui-ci."
