  m_Name: CinemachineShot
  m_EditorClassIdentifier: Unity.Cinemachine::Unity.Cinemachine.CinemachineShot
  DisplayName: Les quatre
  VirtualCamera:
    exposedName: 4c49fa7cbcab53f41adf5f607fc41cd2
    defaultValue: {fileID: 0}
--- !u!114 &-2940086506678521635
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc2fb37c5737f0246becfa8967432f1d, type: 3}
  m_Name: SubtitleClip
  m_EditorClassIdentifier: Assembly-CSharp::LastWorld.SubtitleClip
  speaker: Kael
  text: "Je ne t'ai pas sauv\xE9e pour te voir t'encha\xEEner \xE0 nouveau."
--- !u!114 &-2855522391766884982
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc2fb37c5737f0246becfa8967432f1d, type: 3}
  m_Name: SubtitleClip
  m_EditorClassIdentifier: Assembly-CSharp::LastWorld.SubtitleClip
  speaker: Kael
  text: Tu ne te souviens pas de la veille de ton sacrifice. Moi, je me souviens de chaque heure.
--- !u!114 &-2757301703967420461
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc2fb37c5737f0246becfa8967432f1d, type: 3}
  m_Name: SubtitleClip
  m_EditorClassIdentifier: Assembly-CSharp::LastWorld.SubtitleClip
  speaker: Aelis
  text: "Il y a une troisi\xE8me voie. Elle est derri\xE8re moi : ils sont quatre, et ils ne sont pas des dieux."
