  m_Name: SubtitleClip
  m_EditorClassIdentifier: Assembly-CSharp::LastWorld.SubtitleClip
  speaker: Aelis
  text: "Si je ne le fais pas, Aerendal s'\xE9teint."
--- !u!114 &-4013941830886428774
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
